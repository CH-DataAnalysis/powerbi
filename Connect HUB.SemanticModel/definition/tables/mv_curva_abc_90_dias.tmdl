	column status_produto =
			
			SWITCH(TRUE(),
			    mv_curva_abc_90_dias[dias_sem_venda] > 90 && mv_curva_abc_90_dias[vlr_total] > 1000, "Estoque parado crítico",
			    mv_curva_abc_90_dias[dias_sem_venda] > 60, "Estoque parado",
			    mv_curva_abc_90_dias[cobertura_estoque_dias] > 120, "Cobertura muito alta",
			    mv_curva_abc_90_dias[cobertura_estoque_dias] < 15, "Risco de ruptura",
			    "OK"
			)
		lineageTag: 6d2c791d-d4ac-4062-b7c6-aa3853108753
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cod_barra_tratado =
			
			VAR padrao = LOOKUPVALUE(
			    produto_gcp[cod_barra],
			    produto_gcp[cod_barra],
			    mv_curva_abc_90_dias[cod_barra]
			)
			RETURN
			IF(
			    ISBLANK(padrao),
			    0,
			    padrao
			)
		formatString: 0
		lineageTag: 0ed177da-dd89-4ae4-80a7-803e0f851f4a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

