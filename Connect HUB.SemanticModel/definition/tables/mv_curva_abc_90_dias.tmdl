table mv_curva_abc_90_dias
	lineageTag: 09572ff5-d5ef-40ab-b1ce-86588a785a2f

	measure *skus_estoque =
			CALCULATE(
			    DISTINCTCOUNT(mv_curva_abc_90_dias[cod_barra]),
			    filter(mv_curva_abc_90_dias, mv_curva_abc_90_dias[qtd_estoque] > 0)
			 )
		formatString: #,0
		lineageTag: 3c8e6d40-9033-4fb9-93fb-dada4fb59604

	measure *qtd_produtos_risco_ruptura =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(mv_curva_abc_90_dias[cod_barra]),
			        mv_curva_abc_90_dias[status_produto] = "Risco de ruptura",
			        mv_curva_abc_90_dias[qtd_estoque] > 0
			    ),
			    0
			)
		formatString: #,0
		lineageTag: 8b57fc2f-57ff-43e9-8c85-e8a682deaa0a

	measure *qtd_produtos_estoque_parado =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(mv_curva_abc_90_dias[cod_barra]),
			        mv_curva_abc_90_dias[status_produto] = "Estoque parado",
			        mv_curva_abc_90_dias[qtd_estoque] > 0
			    ),
			    0
			)
		formatString: #,0
		lineageTag: fbe7944c-a1d5-4753-82c4-9f9eed661b7d

	measure *qtd_produtos_cobertura_alta =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(mv_curva_abc_90_dias[cod_barra]),
			        mv_curva_abc_90_dias[status_produto] = "Cobertura muito alta",
			        mv_curva_abc_90_dias[qtd_estoque] > 0
			    ),
			    0
			)
		formatString: #,0
		lineageTag: 590edb17-c523-471a-a9f9-e982dff9e062

	measure *qtd_estoque_curva_abc = SUM(mv_curva_abc_90_dias[qtd_estoque])
