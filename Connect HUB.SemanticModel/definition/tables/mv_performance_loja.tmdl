	measure %_qtd_lojas_performance_bom =
			
			DIVIDE(
			    COALESCE([***qtd_lojas_performance_bom], 0),
			    [*qtd_total_lojas],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 03f36629-6bed-4e3a-94e8-01154a488080

