table mv_performance_loja
	lineageTag: ecc62cb0-3ef3-40e3-9dab-feeaaba672cd

	measure **score_final =
			
			CALCULATE(
			AVERAGE(mv_performance_loja[score_final]),
			    USERELATIONSHIP(calendario[Date],mv_performance_loja[mes])
			)
		formatString: #,0.00
		lineageTag: b5a5601d-0689-49a8-adf1-03ee37fadc5a

	measure **classificacao_performance_loja =
			
			SWITCH(
			    TRUE(),
			    [**score_final] < 40, "Ruim",
			    [**score_final] < 60, "Regular",
			    [**score_final] < 80, "Bom",
			    "Excelente"
			)
		lineageTag: 0e4bd115-8c1f-4dbd-97cd-22924fb7bda1

	measure ***qtd_lojas_performance_bom =
			
			CALCULATE(
			    DISTINCTCOUNT(mv_performance_loja[num_cnpj]),
			    USERELATIONSHIP(calendario[Date], mv_performance_loja[mes]),
			    KEEPFILTERS(
			        ADDCOLUMNS(
			            VALUES(mv_performance_loja[num_cnpj]),
			            "@classificacao", [**classificacao_performance_loja]
			        )
			    ),
			    FILTER(
			        VALUES(mv_performance_loja[num_cnpj]),
			        [**classificacao_performance_loja] = "Bom"
			    )
			)
		formatString: 0
		lineageTag: 29fd75de-4309-4227-8b91-a88e13c60a40

