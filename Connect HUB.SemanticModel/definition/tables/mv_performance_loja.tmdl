	partition mv_performance_loja = m
		mode: import
		source =
				let
				    NomeTabela = "mv_performance_loja_" & Text.From(cliente),
				
				    Fonte = AmazonRedshift.Database(
				        "bc-prod.c9lkmnbigxth.us-east-1.redshift.amazonaws.com:5439",
				        "business_connect"
				    ),
				
				    associacao = Fonte{[Name="associacao"]}[Data],
				
				    Resultado = associacao{[Name=NomeTabela]}[Data],
				
				    #"Columns removed by Measure Killer" = Table.SelectColumns(
				        Resultado,
				        {
				            "mes",
				            "score_media_itens",
				            "score_atendimento",
				            "num_cnpj",
				            "score_final",
				            "score_ticket_medio",
				            "score_lucro"
				        }
				    )
				
				in
				    #"Columns removed by Measure Killer"

	annotation PBI_NavigationStepName = Navegação

