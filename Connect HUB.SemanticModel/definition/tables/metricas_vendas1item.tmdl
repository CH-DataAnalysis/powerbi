	partition metricas_vendas1item = calculated
		mode: import
		source = ```
				{
				    ("Venda Bruta", NAMEOF('mv_vendas_produtos'[**venda_bruta]), 0),
				    ("Venda Líquida", NAMEOF('mv_vendas_produtos'[*venda_liquida_h]), 1),
				    ("Valor do Desconto", NAMEOF('mv_vendas_produtos'[*valor_desconto_venda]), 2),
				    ("CMV Aquisição", NAMEOF('mv_vendas_produtos'[*valor_custo_aquisicao]), 3),
				    ("% CMV Líquido", NAMEOF('mv_vendas_produtos'[**%cmv_liquido]), 4), 
				    ("Venda Líquida 1 item", NAMEOF('mv_vendas_produtos'[**Vlr_Vendas_1_Item_mes_atual]), 5),
				    ("Ticket médio 1Item", NAMEOF('mv_vendas_produtos'[***Ticket_medio_1_Item]), 6),
				    ("Qtd. Atendimentos", NAMEOF('mv_vendas_produtos'[*qtd_atendimento_venda]), 7),
				    ("Qtd. Venda 1 item", NAMEOF('mv_vendas_produtos'[**Qtd_Cupons_1_Item]), 8),
				    ("% Participação de Vendas", NAMEOF('mv_vendas_produtos'[*%participacao_venda]),9)
				}
				```

