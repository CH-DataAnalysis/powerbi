table metricas_vendas1item
	lineageTag: 3cc723c1-0012-4e32-8497-f7f563e682a0

	measure Cor_%_Cupons_1_Item =
			
			VAR Indice =
			    mv_vendas_produtos[**%_Cupons_1_Item]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        Indice >= 0.80, "#fc282f",   -- Emergencial
			        Indice >= 0.50, "#f87171",   -- Crítico
			        Indice >= 0.20, "#fcba03",   -- Atenção
			        "#00689F"                    -- Normal
			    )
		lineageTag: b36ba2fb-0042-4691-af5a-fc6e3cb59067

	measure Cor_%LucroPerdido =
			
			VAR Valor =
			    [***%LucroPerdido]
			
			RETURN
			    IF(
			        Valor < 0,
			        "#C00000",
			        "#008000"
			    )
		lineageTag: 9b52266b-f4bc-4c8c-9763-6d9d50db55b5

