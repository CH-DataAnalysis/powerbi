	column cod_barra_tratado =
			
			VAR padrao = LOOKUPVALUE(
			    produto_gcp[cod_barra],
			    produto_gcp[cod_barra],
			    mv_estoque[cod_barra]
			)
			RETURN
			IF(
			    ISBLANK(padrao),
			    0,
			    padrao
			)
		formatString: 0
		lineageTag: 7a460575-1ed8-4fcf-89d2-f652051e4788
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition mv_estoque = m
		mode: import
		source =
				let
				    NomeTabela = "mv_estoque_" & Text.From(cliente),
				
				    Fonte = AmazonRedshift.Database(
				        "bc-prod.c9lkmnbigxth.us-east-1.redshift.amazonaws.com:5439",
				        "business_connect"
				    ),
				
				    associacao = Fonte{[Name="associacao"]}[Data],
				
				    Resultado = associacao{[Name=NomeTabela]}[Data],
				
				    #"Columns removed by Measure Killer" = Table.SelectColumns(
				        Resultado,
				        {
				            "perda_stockout_6m",
				            "em_ruptura_1m",
				            "ultima_compra",
				            "valor_vendido_3m",
				            "qtd_vendida_1m",
				            "data_generica",
				            "em_ruptura_3m",
				            "num_cnpj",
				            "valor_vendido_6m",
				            "qtd_vendida_3m",
				            "cod_barra",
				            "valor_vendido_1m",
				            "ultima_venda",
				            "perda_stockout_1m",
				            "perda_stockout_3m",
				            "dias_sem_compra",
				            "dias_sem_venda",
				            "qtd_vendida_6m",
				            "qtd_estoque",
				            "em_ruptura_6m"
				        }
				    )
				
				in
				    #"Columns removed by Measure Killer"

