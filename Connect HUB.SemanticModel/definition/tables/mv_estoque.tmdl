	measure *nivel_servico_cor =
			
			VAR ns = [*nivel_servico]
			RETURN
			    SWITCH (
			        TRUE(),
			        ns > 0.90, "#4CAF50",   -- verde
			        ns > 0.80, "#FDD663",   -- amarelo
			        ns <= 0.80, "#e8756f"   -- vermelho
			    )
		lineageTag: 8c329e18-270c-4f5b-857e-03cb5adddcaa

