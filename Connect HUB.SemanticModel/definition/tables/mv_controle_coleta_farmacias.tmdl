	column status_captacao_venda_cor =
			
			SWITCH(
			    [status_venda],
			    "SEM REGISTRO", "#FFD95E",
			    "CAPTAÇÃO OK", "#A8E6A3",
			    "CAPTAÇÃO APRESENTANDO PROBLEMA", "#FFB3B3",
			    BLANK()
			)
		lineageTag: 2f7b8dc4-7859-423f-964f-3cc9282efa8c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column classificacao_captacao_cor =
			
			SWITCH(
			    [classificacao_captacao_venda],
			    "SEM REGISTRO", "#FFD95E",     // amarelo escuro
			    "CAPTAÇÃO OK", "#A8E6A3",      // verde claro
			    "2 A 7 DIAS", "#FFF3B0",       // amarelo claro
			    "8 A 15 DIAS", "#FFB3B3",      // vermelho claro
			    "> 15 DIAS", "#E57373",        // vermelho escuro
			    BLANK()
			)
		lineageTag: 88cec0a2-c494-424e-bc2e-671c223186fd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column status_captacao_compra_cor =
			
