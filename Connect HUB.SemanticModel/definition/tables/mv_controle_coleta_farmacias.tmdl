table mv_controle_coleta_farmacias
	lineageTag: e7e866c7-a317-4b0d-8c35-2921c4643832

	measure *qtd_cnpjs_controle_coleta = DISTINCTCOUNT(mv_controle_coleta_farmacias[num_cnpj])
		formatString: #,0
		lineageTag: 66b445f2-9a41-4ec2-89d6-3b3091f330b0

	measure *qtd_cnpjs_captacao_ok =
			
			CALCULATE(
			    DISTINCTCOUNT(mv_controle_coleta_farmacias[num_cnpj]),
			    FILTER(
			        mv_controle_coleta_farmacias, mv_controle_coleta_farmacias[status_venda] = "CAPTAÇÃO OK"
			    )
			)
		formatString: #,0
		lineageTag: b3f89f3d-4159-4e91-a88a-f4a39dad80a6

	measure *qtd_cnpjs_captacao_problema =
			
			CALCULATE(
			    DISTINCTCOUNT(mv_controle_coleta_farmacias[num_cnpj]),
			    FILTER(
			        mv_controle_coleta_farmacias, mv_controle_coleta_farmacias[status_venda] = "CAPTAÇÃO APRESENTANDO PROBLEMA"
			    )
			)
		formatString: #,0
		lineageTag: bcf92e3b-c68b-4193-be33-2e3ee068a2f7

	measure *%var_qtd_cnpjs_captacao_ok = ```
			
			    DIVIDE(
			        mv_controle_coleta_farmacias[*qtd_cnpjs_captacao_ok],
			        mv_controle_coleta_farmacias[*qtd_cnpjs_controle_coleta]
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 32013c93-77cc-4a7c-8006-e71237e03f5f

	measure *%var_qtd_cnpjs_captacao_problema = ```
			
			    DIVIDE(
			        mv_controle_coleta_farmacias[*qtd_cnpjs_captacao_problema],
			        mv_controle_coleta_farmacias[*qtd_cnpjs_controle_coleta]
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: da993ed3-87e1-4212-93b4-3871a7168e5b

