	partition mv_controle_coleta_farmacias = m
		mode: import
		source =
				let
				    NomeTabela = "mv_controle_coleta_farmacias_" & Text.From(cliente),
				
				    Fonte = AmazonRedshift.Database("bc-prod.c9lkmnbigxth.us-east-1.redshift.amazonaws.com:5439","business_connect"),
				
				    associacao = Fonte{[Name="associacao"]}[Data],
				
				    Resultado = associacao{[Name=NomeTabela]}[Data],
				
				    #"Duplicatas Removidas" = Table.Distinct(
				        Resultado,
				        {"num_cnpj"}
				    ),
				
				    #"Columns removed by Measure Killer" = Table.SelectColumns(#"Duplicatas Removidas",{"num_cnpj", "associacao", "sistema", "ult_registro_venda", "dias_sem_venda", "dias_com_venda_mes_atual", "status_venda", "classificacao_captacao_venda", "ult_registro_compra", "dias_sem_compra", "dias_com_compras_mes_atual", "status_compra", "ult_registro_estoque"})
				
				in
				    #"Columns removed by Measure Killer"

