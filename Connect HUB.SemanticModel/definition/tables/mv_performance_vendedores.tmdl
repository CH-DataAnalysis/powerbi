			)
		lineageTag: 46c2fe3e-2e58-409a-b023-9a89233f84f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _lucro =
			
			CALCULATE(
			    SUM(mv_performance_vendedores[lucro]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 8b57f282-a068-43b3-b3a5-9eed42682a37

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure _total_vendas =
			
			CALCULATE(
			    AVERAGE(mv_performance_vendedores[total_vendas]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 9d6bf737-10db-4ebd-a570-53e57a1166f1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure _ticket_medio =
			
			CALCULATE(
			    SUM(mv_performance_vendedores[ticket_medio]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d5e92ffb-3a7f-4a20-ba6c-4a569c249a3c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure _score_medidas =
			
			"Score Ticket médio: " &[_score_ticket_medio]
			    & UNICHAR(10) &
			"Score Média de itens: " &[_score_media_itens]
			    & UNICHAR(10) &
			"Score Lucro: " &[_score_lucro]
			    & UNICHAR(10) &
			"Score Atendimentos: " &[_score_atendimento]
		lineageTag: 0c1fb1e6-343a-4500-9cf2-d57a82094074

	measure _%qtd_vendedores_excelente =
			
			DIVIDE(
			    COALESCE([_qtd_vendedor_excelente], 0),
			    [_qtd_vendedor],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0f4c384b-1c3c-4e4d-b61a-1c41d0821922

	measure _qtd_vendedor =
			
