table mv_performance_vendedores
	lineageTag: 43f13965-d427-42a6-9887-a0c27812efb7

	measure _qtd_vendedor_excelente =
			
			CALCULATE(
			    DISTINCTCOUNT(mv_performance_vendedores[cod_vendedor_ivend]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes]),
			    FILTER(
			        mv_performance_vendedores,
			        mv_performance_vendedores[classificacao_performance] = "Excelente"
			    )
			)
		formatString: 0
		lineageTag: 25213caa-3356-424c-876a-3681a9aeacbc

	measure _qtd_vendedor_bom =
			
			CALCULATE(
			    DISTINCTCOUNT(mv_performance_vendedores[cod_vendedor_ivend]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes]),
			    FILTER(
			        mv_performance_vendedores,
			        mv_performance_vendedores[classificacao_performance] = "Bom"
			    )
			)
		formatString: 0
		lineageTag: 8b4a4a55-cf34-4784-85b5-ca94d60c8b8c

	measure _qtd_vendedor_regular =
			
			CALCULATE(
			    DISTINCTCOUNT(mv_performance_vendedores[cod_vendedor_ivend]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes]),
			    FILTER(
			        mv_performance_vendedores,
			        mv_performance_vendedores[classificacao_performance] = "Regular"
			    )
			)
		formatString: 0
		lineageTag: 4551d91b-b8ea-4048-85eb-932efa7ae320

	measure _qtd_vendedor_precisa_melhorar =
			
			CALCULATE(
			    DISTINCTCOUNT(mv_performance_vendedores[cod_vendedor_ivend]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes]),
			    mv_performance_vendedores[classificacao_performance] IN {
			        "Precisa Melhorar",
			        "Baixa Amostra"
			    }
			)
		formatString: 0
		lineageTag: 2602c728-7076-4a90-904d-dcbd9ba3c802

	measure _score_final =
			
			CALCULATE(
			    AVERAGE(mv_performance_vendedores[score_final]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		lineageTag: 7c1dbf8e-469b-4bd4-ac23-a96f445f705f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _classificacao_performance_cor =
			
			SWITCH(
			    TRUE(),
			    [_score_final] < 40, "#F28B82",   -- vermelho suave
			    [_score_final] < 60, "#FDD663",   -- amarelo suave
			    [_score_final] < 80, "#81C995",   -- verde suave
			    "#8AB4F8"                                -- azul suave
			)
		lineageTag: 3bc16974-f391-4250-b8a9-bfa89f83cac5

	measure _score_atendimento =
			
			CALCULATE(
			    AVERAGE(mv_performance_vendedores[score_atendimento]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		formatString: #,0.00
		lineageTag: 2ac9a0b1-db81-46df-af92-9159cd024606

	measure _score_ticket_medio =
			
			CALCULATE(
			    AVERAGE(mv_performance_vendedores[score_ticket_medio]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		formatString: #,0.00
		lineageTag: 5c8126ee-0c55-4a1a-a21b-252a7925ff82

	measure _score_lucro =
			
			CALCULATE(
			    AVERAGE(mv_performance_vendedores[score_lucro]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		formatString: #,0.00
		lineageTag: 6826c3f5-9692-4bb3-89f9-fed003131b7f

	measure _score_media_itens =
			
			CALCULATE(
			    AVERAGE(mv_performance_vendedores[score_media_itens]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		formatString: #,0.00
		lineageTag: 88aa7457-e1b9-4588-97ce-dd4f37c6d956

	measure _qtd_atendimento =
			
			CALCULATE(
			    SUM(mv_performance_vendedores[qtd_atendimento]),
			    USERELATIONSHIP(calendario[Date],mv_performance_vendedores[mes])
			)
		formatString: #,0
		lineageTag: 5f6cfa1e-ea3f-40e8-a1b9-a0989682fd3d

	measure _media_itens =
			
			CALCULATE(
			    AVERAGE(mv_performance_vendedores[media_itens]),
