	column *perc_demanda_atendida = mv_sugestao_transferencia_filiais[perc_demanda_atendida] / 100
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fa83546a-7a3c-42ea-86b3-31bfe1805668
