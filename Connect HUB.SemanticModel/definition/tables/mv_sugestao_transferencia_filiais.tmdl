table mv_sugestao_transferencia_filiais
	lineageTag: b81a4fb4-04af-4197-9bf0-78cfe2a9d8df

	measure *qtd_disponivel_origem =
			CALCULATE(
			    SUM(mv_sugestao_transferencia_filiais[qtd_disponivel_origem]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_sugestao_transferencia_filiais[cod_barra_tratado])
			)
		formatString: #,0
		lineageTag: 808073d3-a6be-40f2-a7d2-da8420aed287

