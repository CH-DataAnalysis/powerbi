		annotation SummarizationSetBy = Automatic

	column cod_barra_tratado =
			
			VAR padrao = LOOKUPVALUE(
			    produto_gcp[cod_barra],
			    produto_gcp[cod_barra],
			    mv_sugestao_transferencia_filiais[cod_barra]
			)
			RETURN
			IF(
			    ISBLANK(padrao),
			    0,
			    padrao
			)
		formatString: 0
		lineageTag: 7f65f7b0-7e72-471b-8f41-2c8d0ca2f002
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition mv_sugestao_transferencia_filiais = m
		mode: import
		source =
				let
				    NomeTabela = "mv_sugestao_transferencia_filiais_" & Text.From(cliente),
				
				    Fonte = AmazonRedshift.Database(
				        "bc-prod.c9lkmnbigxth.us-east-1.redshift.amazonaws.com:5439",
				        "business_connect"
				    ),
				
				    associacao = Fonte{[Name="associacao"]}[Data],
				
				    Resultado = associacao{[Name=NomeTabela]}[Data],
				
				    #"Columns removed by Measure Killer" = Table.SelectColumns(
				        Resultado,
				        {
				            "cod_barra",
				            "loja_origem",
				            "loja_destino",
				            "dias_cobertura",
				            "demanda_90d_destino",
				            "curva_abc_origem",
				            "dt_ultima_venda_origem",
				            "qtd_disponivel_origem",
				            "potencial_economia_total",
				            "perc_demanda_atendida",
				            "dt_ultima_venda_destino",
				            "qtd_sugerida_transferencia",
				            "curva_abc_destino"
				        }
				    )
				
				in
				    #"Columns removed by Measure Killer"

