	column melhor_fornecedor =
			
			mv_sugestao_compras[nome_fornecedor]
			    & UNICHAR(10) &
			FORMAT(mv_sugestao_compras[data_menor_valor], "dd/MM/yyyy")
			    & UNICHAR(10) &
			FORMAT(mv_sugestao_compras[qtd_menor_valor_negociado], "#,##0")& " Un."
		lineageTag: 8ca01364-7702-4a5e-bbe2-2cb7a5be281a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cod_barra_tratado =
			
			VAR padrao = LOOKUPVALUE(
			    produto_gcp[cod_barra],
			    produto_gcp[cod_barra],
			    mv_sugestao_compras[cod_barra]
			)
			RETURN
			IF(
			    ISBLANK(padrao),
			    0,
			    padrao
			)
		formatString: 0
		lineageTag: 6e229777-2eab-446a-8cf1-da2cc7d36755
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition mv_sugestao_compras = m
		mode: import
		source =
				let
				    NomeTabela = "mv_sugestao_compras_" & Text.From(cliente),
				
				    Fonte = AmazonRedshift.Database(
				        "bc-prod.c9lkmnbigxth.us-east-1.redshift.amazonaws.com:5439",
				        "business_connect"
				    ),
				
				    associacao = Fonte{[Name="associacao"]}[Data],
				
				    Resultado = associacao{[Name=NomeTabela]}[Data],
				
				    #"Columns removed by Measure Killer" = Table.SelectColumns(
				        Resultado,
				        {
				            "fornecedor_ultima_entrada",
				            "data_menor_valor",
				            "qtd_estoque",
				            "valor_ultima_entrada",
				            "classificacao_valor",
