table mv_sugestao_compras
	lineageTag: 39911c13-976b-4a6c-b4a5-3bbfa2f490ed

	measure *qtd_compra_ultima_entrada =
			CALCULATE(
			SUM('mv_sugestao_compras'[qtd_compra_ultima_entrada]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_sugestao_compras[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_sugestao_compras[data_ultima_entrada])
			)
		formatString: #,0
		lineageTag: 36801e21-0119-4425-b496-d04278e30820

	measure *qtd_estoque =
			CALCULATE(
			SUM('mv_sugestao_compras'[qtd_estoque]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_sugestao_compras[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_sugestao_compras[data_ultima_entrada])
			)
		formatString: #,0
		lineageTag: 2e17485c-3298-437e-a2eb-9d4952a87766

	measure *%var_valor_atual_x_menor_valor = (([*valor_ultima_entrada] - [*menor_valor_negociado]) / [*menor_valor_negociado])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 085bc5fc-469c-4a63-9c19-9eb549c866aa

	measure *menor_valor_negociado =
			CALCULATE(
			SUM('mv_sugestao_compras'[menor_valor_negociado]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_sugestao_compras[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_sugestao_compras[data_ultima_entrada])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: e2c95918-ca61-45f4-bcaf-dcd930124cff

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure *potencial_economia = [*valor_ultima_entrada] - [*menor_valor_negociado]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 286781dd-89ea-4593-96ce-ceba1cce08f1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure *qtd_produtos =
			CALCULATE(
			DISTINCTCOUNT(mv_sugestao_compras[cod_barra]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_sugestao_compras[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_sugestao_compras[data_ultima_entrada])
			)
		formatString: #,0
		lineageTag: 43a1fed6-84e8-49ec-b81c-813a4637c776

	measure *qtd_produtos_acima_melhor_preco =
			CALCULATE(
			DISTINCTCOUNT(mv_sugestao_compras[cod_barra]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_sugestao_compras[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_sugestao_compras[data_ultima_entrada]),
			    FILTER(mv_sugestao_compras,mv_sugestao_compras[classificacao_valor] <> "Melhor preço")
			)
		formatString: #,0
		lineageTag: 8f80585c-5ce0-4bd0-b880-b0efec6ffef4

	measure cor_linha = ```
			
			VAR menor_valor_negociado = 'mv_sugestao_compras'[*menor_valor_negociado]
			VAR valor_ultima_entrada = 'mv_sugestao_compras'[*valor_ultima_entrada]
			VAR classificacao =
			    SWITCH(
			        TRUE(),
			        menor_valor_negociado > 0 && ABS(valor_ultima_entrada - menor_valor_negociado) < 0.001, "Melhor preço",
			        menor_valor_negociado > 0 && valor_ultima_entrada > 0 && valor_ultima_entrada <= menor_valor_negociado * 1.10, "Acima do menor",
			        "Crítico + 10%"
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    classificacao = "Melhor preço", "#ECFDF5",       // Verde claro
			    classificacao = "Acima do menor", "#FEF2F2",     // Vermelho claro
			    classificacao = "Crítico + 10%", "#FEE2E2",      // Vermelho mais forte
			    BLANK()
			)
			
			```
		lineageTag: 779360d4-8a28-4c06-b3db-e7c5c8d004c5

	measure *valor_ultima_entrada =
			CALCULATE(
			SUM('mv_sugestao_compras'[valor_ultima_entrada]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_sugestao_compras[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_sugestao_compras[data_ultima_entrada])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 11f4320d-97eb-4110-847a-751bc250aaf8

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure cor_fonte =
			
			VAR menor_valor_negociado = 'mv_sugestao_compras'[*menor_valor_negociado]
			VAR valor_ultima_entrada = 'mv_sugestao_compras'[*valor_ultima_entrada]
			VAR classificacao =
			    SWITCH(
			        TRUE(),
			        menor_valor_negociado > 0 && ABS(valor_ultima_entrada - menor_valor_negociado) < 0.001, "Melhor preço",
			        menor_valor_negociado > 0 && valor_ultima_entrada > 0 && valor_ultima_entrada <= menor_valor_negociado * 1.10, "Acima do menor",
			        "Crítico + 10%"
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    classificacao = "Melhor preço", "#059669",       // Verde claro
			    classificacao = "Acima do menor", "#DC2626",     // Vermelho claro
			    classificacao = "Crítico + 10%", "#DC2626",      // Vermelho mais forte
			    BLANK()
			)
		lineageTag: 6120d671-d5b1-4c3d-9b08-0b781173bcb2

	measure cor_fonte_status =
			
			VAR menor_valor_negociado = 'mv_sugestao_compras'[*menor_valor_negociado]
			VAR valor_ultima_entrada = 'mv_sugestao_compras'[*valor_ultima_entrada]
			VAR classificacao =
			    SWITCH(
			        TRUE(),
			        menor_valor_negociado > 0 && ABS(valor_ultima_entrada - menor_valor_negociado) < 0.001, "Melhor preço",
			        menor_valor_negociado > 0 && valor_ultima_entrada > 0 && valor_ultima_entrada <= menor_valor_negociado * 1.10, "Acima do menor",
			        "Crítico + 10%"
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    classificacao = "Melhor preço", "#ECFDF5",       // Verde claro
			    classificacao = "Acima do menor", "#DC2626",     // Vermelho claro
			    classificacao = "Crítico + 10%", "#DC2626",      // Vermelho mais forte
			    BLANK()
			)
		lineageTag: 58854b0f-f272-4b79-86f8-4347f3639e86

