table mv_compras_produtos
	lineageTag: 8f5c31a8-1143-49d3-a772-10ec5acc876f

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 2
		incrementalGranularity: day
		incrementalPeriods: 30
		pollingExpression = let Maxdat_atualiza = List.Max(mv_compras_produtos[dat_atualiza]), accountForNull = if Maxdat_atualiza = null then #datetime(1901, 01, 01, 00, 00, 00) else Maxdat_atualiza in accountForNull
