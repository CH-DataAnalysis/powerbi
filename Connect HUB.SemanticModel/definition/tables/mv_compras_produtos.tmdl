	column cod_barra_tratado =
			
			VAR padrao = LOOKUPVALUE(
			    produto_gcp[cod_barra],
			    produto_gcp[cod_barra],
			    mv_compras_produtos[cod_barra]
			)
			RETURN
			IF(
			    ISBLANK(padrao),
			    0,
			    padrao
			)
		formatString: 0
		lineageTag: 3a43c63d-557e-46d2-9497-de2aa8b18ae3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column num_cnpj_fornecedor_tratado =
			
			VAR padrao =
			    LOOKUPVALUE(
			        cadastro_fornecedor[cnpj_fornecedor],
			        cadastro_fornecedor[cnpj_fornecedor],
			        VALUE(mv_compras_produtos[num_cnpj_forncedor_formatado])
			    )
			RETURN
			    COALESCE(padrao, 0)
		dataType: int64
		formatString: 0
		lineageTag: dece8768-cfa7-4e2c-b5be-573efade52e1
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

