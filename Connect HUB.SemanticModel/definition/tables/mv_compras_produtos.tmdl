			let
			    NomeTabela = "mv_compras_produtos_asfar_teste", //& Text.From(cliente),
			
			    Fonte = AmazonRedshift.Database("bc-prod.c9lkmnbigxth.us-east-1.redshift.amazonaws.com:5439","business_connect"),
			
			    associacao = Fonte{[Name="associacao"]}[Data],
			
			    Resultado = associacao{[Name=NomeTabela]}[Data],
			
			    #"Columns removed by Measure Killer" = Table.SelectColumns(Resultado,{"num_cnpj", "num_nota", "cod_barra", "nom_produto", "nom_fornec", "nom_laborat", "dat_entrada", "num_cnpj_forncedor_formatado", "dat_atualiza", "cmv_compras", "vlr_total_compra_bruta", "vlr_total_despacess", "vlr_total_frete", "vlr_total_icmsret", "vlr_total_icms", "vlr_total_ipi", "vlr_total_seguro", "vlr_total_descto", "vlr_total_nfe", "qtd_produto_compra"}),
			
			    #"Tipo Alterado" = Table.TransformColumnTypes(
			        #"Columns removed by Measure Killer",
			        {{"dat_entrada", type datetime}}
			    ),
			
			    #"Tipo Alterado1" = Table.TransformColumnTypes(
			        #"Tipo Alterado",
			        {{"dat_atualiza", type datetime}}
			    ),
			
			    #"Linhas Filtradas" = Table.SelectRows(
			        #"Tipo Alterado1",
			        each [dat_entrada] >= RangeStart and [dat_entrada] < RangeEnd
			    )
			
			in
			    #"Linhas Filtradas"

	measure **%var_sku_compra_ano_anterior = DIVIDE([**sku_compra_ano_atual] - [**sku_compra_ano_anterior],[**sku_compra_ano_anterior],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b322d068-16c0-49c6-ad69-b49dab287901

	measure **%var_sku_compra_mes_anterior = (([**sku_compra_mes_atual] - [**sku_compra_mes_anterior]) / [**sku_compra_mes_anterior])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d818c939-c18e-4301-9e76-66ebeae98911

	measure **sku_compra_ano_anterior = ```
			
			VAR DataAtual =
			    TODAY()
			
			VAR AnoAnterior =
			    YEAR(DataAtual) - 1
			
			VAR DataInicialAnoAnterior =
			    DATE(AnoAnterior, 1, 1)
			
			VAR DataFinalAnoAnterior =
			    DATE(AnoAnterior, MONTH(DataAtual), DAY(DataAtual))
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(mv_compras_produtos[cod_barra]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_compras_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_compras_produtos[dat_entrada]),    
			    REMOVEFILTERS(calendario),
			    calendario[Date] >= DataInicialAnoAnterior &&
			    calendario[Date] <= DataFinalAnoAnterior
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 57eba659-339d-4ea5-a81c-59074eff3b4b

	measure **sku_compra_ano_atual =
			
			VAR AnoAtual =
			    MAXX(ALL(calendario), calendario[ano])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(mv_compras_produtos[cod_barra]),
			    REMOVEFILTERS(calendario),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_compras_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_compras_produtos[dat_entrada]),
			    calendario[ano] = AnoAtual
			)
		formatString: 0
		lineageTag: da0e038e-f38b-46a2-bfac-26a497e982ed

	measure **sku_compra_mes_anterior =
			
			VAR DataAtual =
			    MAX(calendario[Date])
			
			VAR DataMesAnterior =
			    EDATE(DataAtual, -1)
			
			VAR DiaLimiteMesAnterior =
			    VAR DataLimiteMesAtual =
			        CALCULATE(
			            MAX(mv_dados_vendas_compras[dat_emissao]),
			            FILTER(
			                ALL(calendario),
			                calendario[ano_mes_numero] = MAX(calendario[ano_mes_numero])
			            )
			        )
			    VAR UltimoDiaMesAtual =
			        CALCULATE(
			            MAX(calendario[Date]),
			            FILTER(
			                ALL(calendario),
			                calendario[ano_mes_numero] = MAX(calendario[ano_mes_numero])
			            )
			        )
			    RETURN
			        IF(
			            DataLimiteMesAtual = UltimoDiaMesAtual,
			            31,
			            DAY(DataLimiteMesAtual)
			        )
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(mv_compras_produtos[cod_barra]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_compras_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_compras_produtos[dat_entrada]),
			    FILTER(
			        ALL(calendario),
			        calendario[Date] >= DATE(YEAR(DataMesAnterior), MONTH(DataMesAnterior), 1) &&
			        calendario[Date] <= DATE(YEAR(DataMesAnterior), MONTH(DataMesAnterior), DiaLimiteMesAnterior)
			    )
			)
		formatString: 0
		lineageTag: a6edf7a4-224f-487a-8539-cb5a4032af3c

	measure **sku_compra_mes_atual = ```
			
			CALCULATE(
			    DISTINCTCOUNT(mv_compras_produtos[cod_barra]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_compras_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_compras_produtos[dat_entrada]),    
			    FILTER(
			        ALL(calendario),
			        calendario[ano_mes] = MAX(calendario[ano_mes])
			    )
			)
			```
		formatString: #,0
		lineageTag: 64d3a590-bd69-4b0a-b3e2-ec6846db4ad8

	measure *%valor_total_descto =
			
