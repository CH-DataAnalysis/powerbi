	measure *valor_desconto_ano_atual_linha_do_tempo =
			
			VAR AnoAtual =
			    MAXX(ALL(calendario), calendario[ano])
			
			RETURN
			CALCULATE(
			    SUM(mv_dados_vendas_compras[vlr_descto]),
			    calendario[ano] = AnoAtual
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
