	measure *%crescimento_descontos_linha_do_tempo =
			
			DIVIDE(
			    [*valor_desconto_ano_atual_linha_do_tempo] - [*valor_desconto_ano_anterior_linha_do_tempo],
			     [*valor_desconto_ano_atual_linha_do_tempo],
