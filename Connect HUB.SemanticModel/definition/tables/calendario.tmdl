		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	column nome_dia_semana
		lineageTag: bcd7a723-f372-4a34-8d06-8dc7a0c4dce3
		summarizeBy: none
		isNameInferred
		sourceColumn: [nome_dia_semana]

		annotation SummarizationSetBy = Automatic

	partition calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2024, 1, 1), TODAY()),
				    
				    -- Partes de data numéricas
				    "ano", YEAR([Date]),
				    "mes", MONTH([Date]),
				    "dia", DAY([Date]),
				    "trimestre", QUARTER([Date]),
				    "dia_do_ano", FORMAT([Date], "DDD"),
				    "semana_do_ano", WEEKNUM([Date], 2),
				    "dia_da_semana", WEEKDAY([Date], 1), -- 1=Domingo, 2=Segunda
				    "nome_dia_semana", FORMAT([Date], "ddd"),
				
				    -- Versões de texto
				    "nome_mes", FORMAT([Date], "MMMM"),
				    "nome_curto_mes", FORMAT([Date], "MMM"),
				    "nome_do_dia", FORMAT([Date], "dddd"),
				    "nome_do_trimestre", "Q" & FORMAT([Date], "Q"),
				
				    -- Chaves auxiliares
				    "ano_mes", FORMAT([Date], "YYYY-MM"),
				    "ano_trimestre", "Q" & FORMAT([Date], "Q") & " " & YEAR([Date]),
				    
				    -- Novo campo numérico
				    "ano_mes_numero", YEAR([Date]) * 100 + MONTH([Date])
				)
				```

	annotation PBI_Id = 6845eaef069c432ab65dd94b67a77ea7

