table mv_vendas_produtos
	lineageTag: 823a7b57-ccb9-4d24-be4f-d865a3fd1478

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 2
		incrementalGranularity: day
		incrementalPeriods: 15
		pollingExpression = let Maxdat_atualiza = List.Max(mv_vendas_produtos[dat_atualiza]), accountForNull = if Maxdat_atualiza = null then #datetime(1901, 01, 01, 00, 00, 00) else Maxdat_atualiza in accountForNull
		sourceExpression =
			let
			    NomeTabela = "mv_vendas_produtos_" & Text.From(cliente),
			
			    Fonte = AmazonRedshift.Database(
			        "bc-prod.c9lkmnbigxth.us-east-1.redshift.amazonaws.com:5439",
			        "business_connect"
			    ),
			
			    associacao = Fonte{[Name="associacao"]}[Data],
			
			    Resultado = associacao{[Name=NomeTabela]}[Data],
			
			    #"Tipo Alterado" = Table.TransformColumnTypes(
			        Resultado,
			        {{"dat_emissao", type datetime}}
			    ),
			
			    #"Linhas Filtradas" = Table.SelectRows(
			        #"Tipo Alterado",
			        each [dat_emissao] >= RangeStart and [dat_emissao] < RangeEnd
			    ),
			
			    #"Tipo Alterado1" = Table.TransformColumnTypes(
			        #"Linhas Filtradas",
			        {{"dat_atualiza", type datetime}}
			    )
			
			in
			    #"Tipo Alterado1"

	measure *venda_liquida_h = ```
			CALCULATE(SUM(mv_vendas_produtos[vlr_total_venda]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao])
			)
			 
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 43650bbb-47c4-488a-9ee4-77f05eb91e2f

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure *ticket_medio_atual_h =
			
			VAR TotalVendas =
			    CALCULATE(
			        SUM(mv_vendas_produtos[vlr_total_venda]),
			        USERELATIONSHIP(calendario[Date], mv_vendas_produtos[dat_emissao]),
			        USERELATIONSHIP(produto_gcp[cod_barra], mv_vendas_produtos[cod_barra_tratado]),
			        USERELATIONSHIP(mv_dados_clientes[cod_cliente],mv_vendas_produtos[cod_cliente])
			    )
			VAR TotalAtendimentos =
			    CALCULATE(
			        DISTINCTCOUNT(mv_vendas_produtos[id_atendimento]),
			        USERELATIONSHIP(calendario[Date], mv_vendas_produtos[dat_emissao]),
			        USERELATIONSHIP(produto_gcp[cod_barra], mv_vendas_produtos[cod_barra_tratado]),
			        USERELATIONSHIP(mv_dados_clientes[cod_cliente],mv_vendas_produtos[cod_cliente])
			    )
			RETURN
			DIVIDE(TotalVendas, TotalAtendimentos, 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 54d5b11b-0f08-41d3-82e5-69d5382c29c5

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure **venda_liquida =
			CALCULATE(
			SUM(mv_vendas_produtos[vlr_total_venda]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao]),
			    USERELATIONSHIP(mv_dados_clientes[cod_cliente],mv_vendas_produtos[cod_cliente])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 9f21f057-bb1e-460b-a411-202e9fccb42f

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure *%margem_lucro_bruta =
			
			COALESCE(
			CALCULATE(
			((SUM(mv_vendas_produtos[vlr_total_venda]) - sum(mv_vendas_produtos[vlr_custo_aquisicao])) / SUM(mv_vendas_produtos[vlr_total_venda])),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao]),
			    USERELATIONSHIP(mv_dados_clientes[cod_cliente],mv_vendas_produtos[cod_cliente])
			),
			0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d43aa507-1e2f-4a5b-a3f3-91d50210a691

	measure *%valor_total_descto_venda =
			
			CALCULATE(
			DIVIDE(
			SUM('mv_vendas_produtos'[vlr_descto]), sum(mv_vendas_produtos[vlr_total_venda_bruta])),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao]),
			    USERELATIONSHIP(mv_dados_clientes[cod_cliente],mv_vendas_produtos[cod_cliente])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f211929d-7e6d-4eec-a2e6-3c10f4e159ad

	measure *lucro_bruto =
			
			CALCULATE(
			SUM(mv_vendas_produtos[vlr_total_venda]) - SUM(mv_vendas_produtos[vlr_custo_aquisicao]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: e16a92d4-f93f-4cba-9b87-3b57197df7de

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure *qtd_atendimento_venda = ```
			
			VAR QtdeVendas =
			    CALCULATE(
			        DISTINCTCOUNT(mv_vendas_produtos[id_atendimento]),
			        mv_vendas_produtos[tip_venda] = "V",
			        USERELATIONSHIP(produto_gcp[cod_barra], mv_vendas_produtos[cod_barra_tratado]),
			        USERELATIONSHIP(calendario[Date], mv_vendas_produtos[dat_emissao]),
			        USERELATIONSHIP(mv_dados_clientes[cod_cliente], mv_vendas_produtos[cod_cliente])
			    )
			 
			VAR QtdeDevolucoes =
			    CALCULATE(
			        DISTINCTCOUNT(mv_vendas_produtos[id_atendimento]),
			        mv_vendas_produtos[tip_venda] = "D",
			        USERELATIONSHIP(produto_gcp[cod_barra], mv_vendas_produtos[cod_barra_tratado]),
			        USERELATIONSHIP(calendario[Date], mv_vendas_produtos[dat_emissao]),
			        USERELATIONSHIP(mv_dados_clientes[cod_cliente], mv_vendas_produtos[cod_cliente])
			    )
			 
			RETURN
			    QtdeVendas - QtdeDevolucoes
			```
		formatString: #,0
		lineageTag: 2c94450a-53b4-45c5-b0f5-2ffe785f1d0b

	measure *qtd_produto_venda =
			CALCULATE(
			SUM(mv_vendas_produtos[qtd_produto_venda]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao]),
			    USERELATIONSHIP(mv_dados_clientes[cod_cliente],mv_vendas_produtos[cod_cliente])
			)
		formatString: #,0
		lineageTag: f8bd5c95-b53b-47d7-b182-750f43c740d7

	measure *sku_venda_ano_anterior = ```
			
			VAR DataAtual =
			    TODAY()
			
			VAR AnoAnterior =
			    YEAR(DataAtual) - 1
			
			VAR DataInicialAnoAnterior =
			    DATE(AnoAnterior, 1, 1)
			
			VAR DataFinalAnoAnterior =
			    DATE(AnoAnterior, MONTH(DataAtual), DAY(DataAtual))
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(mv_vendas_produtos[cod_barra]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao]),    
			    REMOVEFILTERS(calendario),
			    calendario[Date] >= DataInicialAnoAnterior &&
			    calendario[Date] <= DataFinalAnoAnterior
			)
			```
		formatString: 0
		lineageTag: 5525c13f-02f3-42b4-ad35-ac5712f92d79

	measure *sku_venda_ano_atual =
			
			VAR AnoAtual =
			    MAXX(ALL(calendario), calendario[ano])
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(mv_vendas_produtos[cod_barra]),
			    REMOVEFILTERS(calendario),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao]),
			    calendario[ano] = AnoAtual
			)
		formatString: 0
		lineageTag: 1b15c53e-33c2-4c42-935e-ad69e217f4e8

	measure *valor_custo_aquisicao =
			CALCULATE(
			SUM(mv_vendas_produtos[vlr_custo_aquisicao]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao]),
			    USERELATIONSHIP(mv_dados_clientes[cod_cliente],mv_vendas_produtos[cod_cliente])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 4b4748a6-075a-414f-a3e2-d8e839d7f3f5

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure *valor_desconto_venda =
			CALCULATE(
			SUM(mv_vendas_produtos[vlr_descto]),
			    USERELATIONSHIP(produto_gcp[cod_barra],mv_vendas_produtos[cod_barra_tratado]),
			    USERELATIONSHIP(calendario[Date],mv_vendas_produtos[dat_emissao])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 29a5425a-2033-45fa-92e8-f1fb7cf33d09

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure filtro_alerta_desconto_venda =
			
			VAR alertaselecionado = SELECTEDVALUE('alerta_desconto_venda'[alerta], "Todos")
			VAR desconto = [*%valor_total_descto_venda]
			RETURN
			SWITCH(
			    TRUE(),
			    alertaselecionado = "Todos", 1,
			    alertaselecionado = "> que 10%" && desconto > 0.1, 1,
				alertaselecionado = "> que 20%" && desconto > 0.2, 1,
				alertaselecionado = "> que 30%" && desconto > 0.3, 1,
				alertaselecionado = "> que 40%" && desconto > 0.4, 1,
				alertaselecionado = "> que 50%" && desconto > 0.5, 1,
			    0
			)
		formatString: 0
		lineageTag: 735c57af-5157-4849-a151-03382b1a6e65

	measure filtro_alerta_margem_lucro_bruta =
			
			VAR alertaselecionado = SELECTEDVALUE('alerta_margem_lucro_bruta'[alerta], "Todos")
			VAR margem = [*%margem_lucro_bruta]
			RETURN
			SWITCH(
			    TRUE(),
			    alertaselecionado = "Todos", 1,
			    alertaselecionado = "< que 0%" && margem < 0, 1,
			    alertaselecionado = "< que 10%" && margem < 0.1, 1,
				alertaselecionado = "< que 20%" && margem < 0.2, 1,
				alertaselecionado = "< que 30%" && margem < 0.3, 1,
				alertaselecionado = "< que 40%" && margem < 0.4, 1,
				alertaselecionado = "< que 50%" && margem < 0.5, 1,
			    alertaselecionado = "> que 50%" && margem > 0.5, 1,
			    0
			)
		formatString: 0
		lineageTag: 905a8b1d-e327-409b-b0bd-bf05acb07eb2

	measure *%participacao = ```
			
			DIVIDE(
			    CALCULATE(
			        SUM(mv_vendas_produtos[vlr_total_venda]),
			        USERELATIONSHIP(produto_gcp[cod_barra], mv_vendas_produtos[cod_barra_tratado]),
			        USERELATIONSHIP(calendario[Date], mv_vendas_produtos[dat_emissao])
			    ),
			    CALCULATE(
			        SUM(mv_vendas_produtos[vlr_total_venda]),
			        USERELATIONSHIP(produto_gcp[cod_barra], mv_vendas_produtos[cod_barra_tratado]),
			        USERELATIONSHIP(calendario[Date], mv_vendas_produtos[dat_emissao]),
			        ALL(produto_gcp),
			        ALL(calendario)
			    )
			)
			 
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 544f8414-1d18-457a-857e-03bc5e005b9e

	measure filtro_alerta_margem_lucro_bruta_2 =
			
			VAR alertaselecionado = SELECTEDVALUE('alerta_margem_lucro_bruta_2'[alerta], "Todos")
			VAR margem = [*%margem_lucro_bruta]
			RETURN
			SWITCH(
			    TRUE(),
			    alertaselecionado = "Todos", 1,
			    alertaselecionado = "Margem negativa" && margem < 0, 1,
			    alertaselecionado = "Margem positiva" && margem > 0, 1,
			    0
			)
		formatString: 0
		lineageTag: 5ac09a2d-6585-471d-bd4a-b77bb8aabf50

