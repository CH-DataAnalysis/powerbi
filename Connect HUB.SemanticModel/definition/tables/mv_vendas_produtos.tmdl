	column cod_barra_tratado =
			
			VAR padrao = LOOKUPVALUE(
			    produto_gcp[cod_barra],
			    produto_gcp[cod_barra],
			    mv_vendas_produtos[cod_barra]
			)
			RETURN
			IF(
			    ISBLANK(padrao),
			    0,
			    padrao
			)
		formatString: 0
		lineageTag: 264af45e-0b73-4498-b0f5-678491db59a0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column cod_nom_vendedor =
			mv_vendas_produtos[cod_vendedor_ivend]&" - "&mv_vendas_produtos[nom_vendedor_ivend]
			--cod_nom_vendedor = vendas_produtos[cod_vendedor_ivend]&" - "&LEFT(vendas_produtos[nom_vendedor_ivend],2)&"*******"&RIGHT(vendas_produtos[nom_vendedor_ivend],2)
		lineageTag: 00af6b3c-fc58-4c2e-8818-ae193ea56f6d
